# Local browser settings. Do not set VITE_SIGNALING_URL on Vercel: the client
# automatically uses the same-origin wss://<deployment>/api/signal endpoint.
# Never put long-lived TURN secrets in a VITE_* variable.
VITE_SIGNALING_URL=ws://127.0.0.1:8787
VITE_STUN_URL=stun:stun.cloudflare.com:3478
# Optional stable HTTPS origin used when generating invitation links.
# VITE_PUBLIC_APP_URL=https://direct-talk.vercel.app

# Signaling server settings.
SIGNAL_PORT=8787
SIGNAL_HOST=127.0.0.1
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Required on Vercel. Add Redis Cloud from the Vercel Marketplace so Vercel
# creates REDIS_URL automatically. Redis coordinates Function instances and
# never stores chat messages or photo contents.
# REDIS_URL=rediss://default:password@example.redis-cloud.com:6379

# Metered Open Relay TURN (primary provider). Create a free app/API key, copy
# its credentials endpoint without the apiKey query parameter, and configure
# both values in Vercel. Never prefix either variable with VITE_.
# METERED_TURN_CREDENTIALS_URL=https://your-app.metered.live/api/v1/turn/credentials
# METERED_TURN_API_KEY=your-metered-api-key

# Optional Cloudflare Realtime TURN fallback. If both private providers are
# configured, DirectTalk returns every reachable provider so the browser can
# choose a relay that is available from the user's network.
# CLOUDFLARE_TURN_KEY_ID=your-turn-key-id
# CLOUDFLARE_TURN_API_TOKEN=your-turn-key-secret
# Applies only to Cloudflare-generated credentials.
# TURN_CREDENTIAL_TTL_SECONDS=21600
# Optional independent secret used only to hash client addresses for Redis rate limiting.
# TURN_RATE_LIMIT_SECRET=generate-a-long-random-value
