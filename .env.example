# Local browser settings. Do not set VITE_SIGNALING_URL on Vercel: the client
# automatically uses the same-origin wss://<deployment>/api/signal endpoint.
# Never put long-lived TURN secrets in a VITE_* variable.
VITE_SIGNALING_URL=ws://127.0.0.1:8787
VITE_STUN_URL=stun:stun.cloudflare.com:3478

# Signaling server settings.
SIGNAL_PORT=8787
SIGNAL_HOST=127.0.0.1
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Required on Vercel. Add Upstash Redis from the Vercel Marketplace so Vercel
# creates REDIS_URL automatically. Redis coordinates Function instances and
# never stores chat messages or photo contents.
# REDIS_URL=rediss://default:password@example.upstash.io:6379
